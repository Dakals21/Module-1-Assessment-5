# https://git-scm.com/docs/gitignore
# https://help.github.com/articles/ignoring-files
# Example .gitignore files: https://github.com/github/gitignore
/bower_components/
/node_modules/
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dakalo Ecommerce Store</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            color: #222;
        }

        header {
            background-color: #1428A0;
            color: white;
            padding: 20px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 28px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 25px;
            font-weight: bold;
        }

        nav a:hover {
            text-decoration: underline;
        }

        .hero {
            text-align: center;
            padding: 50px 20px;
            background-color: white;
        }

        .hero h2 {
            font-size: 36px;
            margin-bottom: 10px;
            color: #1428A0;
        }

        .hero p {
            font-size: 18px;
            color: #555;
        }

        .products {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;

            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
        }

        .product-card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
            transition: transform 0.2s;
        }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-card img {
            width: 100%;
            height: 250px;
            object-fit: contain;
            margin-bottom: 15px;
        }

        .product-card h3 {
            margin-bottom: 10px;
        }

        .price {
            color: #1428A0;
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .view-button {
            display: inline-block;
            background-color: #1428A0;
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            text-decoration: none;
        }

        .view-button:hover {
            background-color: #0c1b75;
        }

        footer {
            background-color: #222;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 50px;
        }
    </style>
</head>

<body>

<header>
    <h1>Dakalo Ecommerce Store</h1>

    <nav>
        <a href="index.html">Home</a>
        <a href="about.html">About</a>
        <a href="contact.html">Contact Us</a>
    </nav>
</header>

<section class="hero">
    <h2>Samsung Smartphones</h2>
    <p>Discover the latest Samsung smartphones at Dakalo Ecommerce Store.</p>
</section>

<section class="products">

    <div class="product-card">
        <img src="images/s25-ultra.jpg" alt="Samsung Galaxy S25 Ultra">
        <h3>Samsung Galaxy S25 Ultra</h3>
        <p class="price">R24,999</p>
        <a class="view-button" href="products/galaxy-s25-ultra.html">
            View Product
        </a>
    </div>

    <div class="product-card">
        <img src="images/s25.jpg" alt="Samsung Galaxy S25">
        <h3>Samsung Galaxy S25</h3>
        <p class="price">R17,999</p>
        <a class="view-button" href="products/galaxy-s25.html">
            View Product
        </a>
    </div>

    <div class="product-card">
        <img src="images/s24-ultra.jpg" alt="Samsung Galaxy S24 Ultra">
        <h3>Samsung Galaxy S24 Ultra</h3>
        <p class="price">R21,999</p>
        <a class="view-button" href="products/galaxy-s24-ultra.html">
            View Product
        </a>
    </div>

    <div class="product-card">
        <img src="images/a56.jpg" alt="Samsung Galaxy A56">
        <h3>Samsung Galaxy A56</h3>
        <p class="price">R7,999</p>
        <a class="view-button" href="products/galaxy-a56.html">
            View Product
        </a>
    </div>

    <div class="product-card">
        <img src="images/a36.jpg" alt="Samsung Galaxy A36">
        <h3>Samsung Galaxy A36</h3>
        <p class="price">R6,499</p>
        <a class="view-button" href="products/galaxy-a36.html">
            View Product
        </a>
    </div>

</section>

<footer>
    <p>&copy; 2026 Dakalo Ecommerce Store. All Rights Reserved.</p>
</footer>

</body>
</html>